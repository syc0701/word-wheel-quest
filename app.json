{
  "expo": {
    "name": "Word Wheel Quest",
    "slug": "word-wheel-quest",
    "scheme": "puzzleinteract",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-native.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2A4A"
    },
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.puzint.wordwheel.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 12,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0A2A4A"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "./plugins/withEnableEdgeToEdge",
      "./plugins/withAdsSdkPin",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#0A2A4A"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1539854949018984~3656372616",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
