+  private fun getActivity(context: Context?): Activity? {
+    // Iterative on purpose. The old recursive walk ANR'd as
+    // "Input dispatching timed out" when a ContextWrapper chain cycled
+    // (Play blamed GestureHandler.getActivity on the input thread).
+    var current = context
+    var hops = 0
+    while (current != null && hops < 8) {
+      when (current) {
+        is ReactContext -> return current.currentActivity
+        is Activity -> return current
+        is ContextWrapper -> {
+          val next = current.baseContext
+          if (next === current) return null
+          current = next
+        }
+        else -> return null
+      }
+      hops++
     }
+    return null
+  }
 
