@@ -0,0 +1,27 @@
+package expo.modules.plugin
+
+import java.io.File
+
+/**
+ * Resolve a usable Node binary. Android Studio's Gradle daemon often has a
+ * PATH that does not include Homebrew or /usr/local/bin.
+ */
+object NodeBinary {
+  fun resolve(): String {
+    val fromEnv = System.getenv("NODE_BINARY")
+    if (!fromEnv.isNullOrBlank() && File(fromEnv).canExecute()) {
+      return fromEnv
+    }
+
+    listOf(
+      "/usr/local/bin/node",
+      "/opt/homebrew/bin/node",
+    ).forEach { candidate ->
+      if (File(candidate).canExecute()) {
+        return candidate
+      }
+    }
+
+    return "node"
+  }
+}
